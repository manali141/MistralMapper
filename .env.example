# Backend
MISTRAL_API_KEY=your_mistral_api_key

PORT=4000
ALLOWED_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=mistral_mapper
MONGODB_COLLECTION=mappings

# PostgreSQL authentication
DATABASE_URL=postgresql://accountbridge:change_me@localhost:5432/accountbridge
DATABASE_POOL_SIZE=10
SESSION_SECRET=replace_with_at_least_32_random_bytes
APP_URL=http://localhost:5173

# Password reset email
RESEND_API_KEY=re_your_resend_api_key
RESET_EMAIL_FROM=AccountBridge <onboarding@resend.dev>

# Optional bearer token check for POST /api/mappings
MONGO_API_KEY=
